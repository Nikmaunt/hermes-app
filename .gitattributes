# Normalize line endings across platforms.
* text=auto eol=lf

# Windows scripts stay CRLF; the gradle wrapper shell script must stay LF.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary assets — never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
